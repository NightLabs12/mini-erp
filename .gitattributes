# Shell script dan berkas konfigurasi container wajib LF, termasuk saat
# checkout di Windows. CRLF membuat `#!/bin/sh` gagal dieksekusi di container.
*.sh            text eol=lf
Makefile        text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf

*.php           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.neon          text eol=lf
*.xml           text eol=lf

*.png           binary
*.ico           binary
