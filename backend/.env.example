APP_NAME="Mini ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8100
APP_VERSION=0.1.0

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Nilai default di bawah dipakai untuk pengembangan lokal.
# docker compose menimpa DB_HOST menjadi "postgres".
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mini_erp
DB_USERNAME=mini_erp
DB_PASSWORD=mini_erp_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mini-erp.test"
MAIL_FROM_NAME="${APP_NAME}"

# Masa berlaku token Sanctum dalam menit (24 jam).
SANCTUM_EXPIRATION=1440
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Origin yang diizinkan mengakses API (dipisah koma).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mode demo: menonaktifkan perubahan data kritis dan reset harian otomatis.
DEMO_MODE=true
DEMO_PASSWORD=password

# Dokumentasi API terbuka untuk demo portofolio. Set false bila dipakai dengan data nyata.
API_DOCS_PUBLIC=true

# Batas laju request per menit.
API_RATE_LIMIT=120
LOGIN_RATE_LIMIT=5
