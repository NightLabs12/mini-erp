# Identitas proyek Compose. Jangan diubah agar hanya container, network, dan
# volume milik proyek ini yang tersentuh di VPS bersama.
COMPOSE_PROJECT_NAME=minierp-dev

# Semua port dipublikasikan hanya ke loopback (127.0.0.1) agar tidak bentrok
# dengan Coolify (8000), PostgreSQL aplikasi lain (5432), atau Minecraft (25565).
APP_PORT=8100
FRONTEND_PORT=5173
POSTGRES_PORT=5433

# Jumlah proses paralel untuk test konkurensi penomoran dokumen.
# Default 50 dipakai di CI; di VPS bersama turunkan agar hemat RAM/CPU.
SEQUENCE_CONCURRENCY=50
