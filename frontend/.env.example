# Default: browser memanggil /api/v1 dan Vite mem-proxy ke backend.
# Isi nilai absolut bila frontend dan API berada di origin berbeda.
# VITE_API_BASE_URL=http://localhost:8100/api/v1

# Target proxy dev server (dipakai vite.config.ts, bukan kode browser).
VITE_API_PROXY_TARGET=http://localhost:8100
